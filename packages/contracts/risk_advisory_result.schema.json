{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "risk_advisory_result.schema.json",
  "type": "object",
  "required": ["items"],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["symbol", "side", "flags", "scores", "suggested_action"],
        "properties": {
          "symbol": { "type": "string" },
          "side": { "type": "string", "enum": ["buy", "sell"] },
          "flags": {
            "type": "array",
            "items": { "type": "string" }
          },
          "scores": {
            "type": "object",
            "required": ["liquidity", "volatility"],
            "properties": {
              "liquidity": { "type": "number" },
              "volatility": { "type": "number" }
            },
            "additionalProperties": false
          },
          "suggested_action": { "type": "string", "enum": ["auto", "review"] }
        },
        "additionalProperties": false
      }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
