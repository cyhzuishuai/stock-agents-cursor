{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "agent_run_response.schema.json",
  "type": "object",
  "required": ["result", "trace"],
  "properties": {
    "result": { "type": "object" },
    "handoff": { "type": "object" },
    "working_memory": {
      "type": "object",
      "properties": {
        "notes": { "type": "array", "items": { "type": "string" } },
        "evidence_refs": { "type": "array", "items": { "type": "string" } },
        "open_questions": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "trace": {
      "type": "object",
      "required": ["agent", "rounds", "stop_reason"],
      "properties": {
        "agent": { "type": "string", "enum": ["analyst", "portfolio"] },
        "started_at": { "type": "string", "format": "date-time" },
        "ended_at": { "type": "string", "format": "date-time" },
        "rounds": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "stop_reason": {
          "type": "string",
          "enum": ["final", "max_rounds", "timeout", "error"]
        },
        "usage": {
          "type": "object",
          "properties": {
            "prompt_tokens": { "type": "integer", "minimum": 0 },
            "completion_tokens": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": true
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "plan": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "working_memory": {
          "type": "object",
          "properties": {
            "notes": { "type": "array", "items": { "type": "string" } },
            "evidence_refs": { "type": "array", "items": { "type": "string" } },
            "open_questions": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": true
        },
        "router": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
