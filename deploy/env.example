REDIS_URL=redis://redis:6379/0
JWT_SECRET=change-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
INITIAL_CASH=100000
MARKET_DATA_PROVIDER=alpaca
LLM_MODE=mock
LLM_API_KEY=
